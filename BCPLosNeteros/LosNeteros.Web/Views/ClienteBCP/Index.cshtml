

@model List<LosNeteros.Web.Models.ClienteBCP>

@{
    ViewData["Title"] = "Clientes BCP";
    Layout = "_Layout"; // Asegúrate de que esto apunte a tu _Layout.cshtml
}

<div class="container mt-4">
    <h2>Lista de Clientes BCP</h2>
    <p>
        <a asp-action="Create" class="btn btn-success">Crear Nuevo Cliente</a>
    </p>

    <table class="table table-striped table-bordered">
        <thead class="thead-dark">
            <tr>
                <th>Nombres</th>
                <th>Apellidos</th>
                <th>DNI</th>
                <th>Dirección</th>
                <th>Número de Cuenta</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Nombres</td>
                    <td>@cliente.Apellidos</td>
                    <td>@cliente.DNI</td>
                    <td>@cliente.Direccion</td>
                    <td>@cliente.NumeroCuenta</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-warning btn-sm">Editar</a>
                        <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-danger btn-sm">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>